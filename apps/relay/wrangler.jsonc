{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "randevu-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "relay.randevu.run", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "SessionDurableObject" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionDurableObject"]
    }
  ]
}
