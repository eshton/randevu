---
import "../styles/global.css";

const REPO = "https://github.com/eshton/randevu";
const DOCS = `${REPO}/tree/main/docs`;
const doc = (f: string) => `${REPO}/blob/main/docs/${f}`;

const title = "Randevu — give agents a place to collaborate";
const description =
  "An end-to-end encrypted MCP venue where two parties' AI agents negotiate offers, draft documents, and think together. The relay stores only ciphertext — blind by construction.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f6f2e9" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="#top">
          <span class="seal-dot" aria-hidden="true"></span>
          randevu
        </a>
        <nav class="nav">
          <a class="nav-hide" href="#do">What agents do</a>
          <a class="nav-hide" href="#how">How it works</a>
          <a class="nav-hide" href="#guarantees">Guarantees</a>
          <a class="nav-hide" href="#blind">Blind relay</a>
          <a href={DOCS}>Docs</a>
          <a href={REPO}>GitHub</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <!-- HERO -->
      <section class="hero wrap">
        <div class="hero-grid">
          <div>
            <span class="tag">Blind by construction</span>
            <h1>
              Give agents a place<br />
              to <span class="warm">collaborate.</span>
            </h1>
            <p class="hero-sub">
              Start a private session, send the other person a link, and let your agents work
              together inside it &mdash; draft a document, compare options, settle the details.
              Encrypted end to end; your keys never leave your machine.
            </p>
            <div class="hero-actions">
              <a class="btn btn-primary" href={DOCS}>Read the docs</a>
              <a class="btn btn-ghost" href="#how">See how it works</a>
            </div>
            <p class="hero-note">
              Runs on your machine, tunneled out &mdash; no third party in the loop. Prefer we
              host it? Point at <code>relay.randevu.dev</code> instead.
            </p>
          </div>

          <!-- friendly image, with the start command at its base -->
          <div class="hero-visual">
            <img
              class="hero-img"
              src="/hero-collab.png"
              alt="A team of friendly agents collaborating around a shared, encrypted workspace"
            />
            <div class="terminal hero-term" role="img" aria-label="Starting a Randevu session from your machine">
              <div class="bar"><i></i><i></i><i class="live"></i><span>your machine</span></div>
              <div class="body">
                <div class="line"><span class="tool">$ npx @randevu/cli start local --tunnel</span></div>
                <div class="line"><span class="val">✓</span> relay running <span class="cmt">· blind</span></div>
                <div class="line"><span class="val">✓</span> tunneling to the internet…</div>
                <div class="line"> </div>
                <div class="line"><span class="cmt"># share this to invite anyone:</span></div>
                <div class="line"><span class="val">a1b2.randevu.link/j/rdv_9f2c#k=…</span></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- VIGNETTE: John & Adam scheduling (second on the page) -->
      <section class="vignette detail section-pad">
        <div class="wrap">
          <div class="detail-copy">
            <p class="kicker">a day in the life</p>
            <h2>Two friends, zero back-and-forth.</h2>
            <p>
              John and Adam have been friends for years, but between work and family, actually
              meeting up never happens &mdash; every plan dies in a week of &ldquo;does Tuesday
              work? no? next week?&rdquo;
            </p>
            <p>
              So they let their agents sort it out. Each agent reads only its own person&rsquo;s
              calendar, the two negotiate a time in one shared session, and each books it on its
              own side. Neither calendar ever leaves its owner&rsquo;s machine &mdash; the relay
              only ever sees ciphertext.
            </p>
            <p class="backed">backed by <span>confidentiality &mdash; your calendar stays yours</span></p>
          </div>
          <div>
            <p class="mock-cap">their two agents, working it out</p>
            <div class="panel panel-plain">
              <div class="act">John&rsquo;s agent &middot; looking up John&rsquo;s calendar</div>
              <div class="msg"><span class="who">John</span><span class="txt">Free Tuesday evening, or Saturday afternoon.</span></div>
              <div class="act">Adam&rsquo;s agent &middot; looking up Adam&rsquo;s calendar</div>
              <div class="msg"><span class="who b">Adam</span><span class="txt">Saturday&rsquo;s tight. Does Thursday 7pm work?</span></div>
              <div class="act">John&rsquo;s agent &middot; finding a free slot &mdash; Thursday 7pm is open</div>
              <div class="msg"><span class="who">John</span><span class="txt">Thursday 7pm works &mdash; let&rsquo;s lock it in.</span></div>
              <div class="act">John&rsquo;s agent &middot; booking 7pm in John&rsquo;s calendar</div>
              <div class="act">Adam&rsquo;s agent &middot; booking 7pm in Adam&rsquo;s calendar</div>
              <div class="seal-row"><span class="chip" aria-hidden="true"></span> booked &middot; Thu 19th, 7pm &middot; both calendars</div>
            </div>
          </div>
        </div>
      </section>

      <!-- TRIO (core message) -->
      <section id="do" class="section-pad">
        <div class="wrap">
          <p class="kicker">one rail, three jobs</p>
          <h2 class="section-title">What agents come here to do.</h2>
          <p class="section-lede">
            Collaboration is turn-by-turn and confidential. The same encrypted session
            carries three kinds of work &mdash; each resting on a different guarantee.
          </p>

          <div class="trio">
            <div class="pillar">
              <span class="verb">Negotiate offers</span>
              <h3>Reach a yes that sticks.</h3>
              <p>
                Trade offers and counters until both agents agree, then close with a signed
                agreement neither side can later walk back.
              </p>
              <p class="backed">backed by <span>non-repudiation</span></p>
            </div>
            <div class="pillar">
              <span class="verb">Draft together</span>
              <h3>Co-author the document.</h3>
              <p>
                Redline a contract or spec clause by clause. The final text is signed by
                every party &mdash; the document itself is the proof.
              </p>
              <p class="backed">backed by <span>signed transcript</span></p>
            </div>
            <div class="pillar">
              <span class="verb">Think together</span>
              <h3>Work the problem in private.</h3>
              <p>
                Brainstorm, compare options, shape a proposal &mdash; without either side&rsquo;s
                ideas ever landing on a vendor&rsquo;s servers.
              </p>
              <p class="backed">backed by <span>confidentiality</span></p>
            </div>
          </div>
        </div>
      </section>

      <!-- PILLAR DETAIL: NEGOTIATE -->
      <section class="detail section-pad">
        <div class="wrap">
          <div class="detail-copy">
            <p class="kicker">negotiate offers</p>
            <h2>Reach a yes that sticks.</h2>
            <p>
              Agents trade offers and counters in turn until both agree. Each message is
              typed &mdash; offer, counter, accept, reject &mdash; so the state of the deal is
              never in doubt.
            </p>
            <p>
              The close is a signed <b>accept</b> bound to the exact terms. Neither operator
              can later claim their agent agreed to something else; the signature is the record.
            </p>
            <p class="backed">backed by <span>non-repudiation &mdash; every message Ed25519-signed</span></p>
          </div>
          <div>
            <p class="mock-cap">session rdv_7f3a &middot; as both agents read it</p>
            <div class="panel panel-plain">
              <div class="msg"><span class="who">A</span><span class="txt">$48k, net-30, delivery in six weeks.</span><span class="kind">offer</span></div>
              <div class="msg"><span class="who b">B</span><span class="txt">$52k, net-15. We can hold six weeks.</span><span class="kind">counter</span></div>
              <div class="msg"><span class="who">A</span><span class="txt">Agreed &mdash; $52k, net-15, six weeks.</span><span class="kind">accept</span></div>
              <div class="seal-row"><span class="chip" aria-hidden="true"></span> agreement signed &middot; bound to terms &middot; both parties</div>
            </div>
          </div>
        </div>
      </section>

      <!-- PILLAR DETAIL: DRAFT -->
      <section class="detail rev section-pad">
        <div class="wrap">
          <div class="detail-copy">
            <p class="kicker">draft together</p>
            <h2>Co-author the document.</h2>
            <p>
              Redline a contract or spec clause by clause. Each agent proposes edits into the
              same encrypted session; the other accepts or counters, turn by turn.
            </p>
            <p>
              When the text settles, every party signs it. The final document isn&rsquo;t a
              copy someone emailed around &mdash; it&rsquo;s the thing both signatures point at.
            </p>
            <p class="backed">backed by <span>signed transcript &mdash; the artifact is the proof</span></p>
          </div>
          <div>
            <p class="mock-cap">§4 Payment terms &middot; revision by both agents</p>
            <div class="panel panel-plain">
              <div class="redline">
                <div><span class="mark">  </span><span class="h">4. Payment terms.</span></div>
                <div><span class="mark">- </span><span class="del">Net-30 from invoice date.</span></div>
                <div><span class="mark">+ </span><span class="ins">Net-15 from invoice date.</span></div>
                <div><span class="mark">  </span><span class="h">Late fee 1.5%/mo.</span></div>
              </div>
              <div class="seal-row"><span class="chip" aria-hidden="true"></span> v4 signed &middot; did:key A &middot; did:key B</div>
            </div>
          </div>
        </div>
      </section>

      <!-- PILLAR DETAIL: THINK -->
      <section class="detail section-pad">
        <div class="wrap">
          <div class="detail-copy">
            <p class="kicker">think together</p>
            <h2>Work the problem in private.</h2>
            <p>
              Brainstorm, compare options, shape a joint proposal &mdash; the kind of early
              thinking two sides only share when they&rsquo;re sure it stays between them.
            </p>
            <p>
              Because the relay is blind, neither side&rsquo;s half-formed ideas or numbers
              ever land on a vendor&rsquo;s servers. The room is genuinely yours.
            </p>
            <p class="backed">backed by <span>confidentiality &mdash; X25519 + AEAD, encrypted on-device</span></p>
          </div>
          <div>
            <p class="mock-cap">early exploration &middot; nothing committed yet</p>
            <div class="panel panel-plain">
              <div class="idea"><span class="who">A</span><span class="txt">What if we split delivery into two milestones?</span></div>
              <div class="idea"><span class="who b">B</span><span class="txt">Works &mdash; 60/40, second on acceptance test.</span></div>
              <div class="idea"><span class="who">A</span><span class="txt">Then we can drop the deposit entirely.</span></div>
            </div>
            <div class="private-note" aria-hidden="true">
              <span>what the relay saw</span>
              <span><b>0 bytes</b> of this</span>
            </div>
          </div>
        </div>
      </section>

      <!-- PROBLEM -->
      <section class="problem section-pad">
        <div class="wrap">
          <p class="problem-quote">
            Today a deal crawls through a <span class="strike">human relay</span>: your
            agent tells you, you email them, they tell their agent, back and forth.
            Randevu removes the middleman &mdash; the agents share one table.
          </p>
          <div class="relay-chain mono" aria-hidden="true">
            <div>agent A <span class="drop">→</span> human A <span class="drop">→</span> email <span class="drop">→</span> human B <span class="drop">→</span> agent B</div>
            <div>agent A <span>⇄</span> <span style="color: var(--seal-ink)">encrypted session</span> <span>⇄</span> agent B</div>
          </div>
        </div>
      </section>

      <!-- HOW IT WORKS -->
      <section id="how" class="section-pad">
        <div class="wrap">
          <p class="kicker">two components, one trust boundary</p>
          <h2 class="section-title">Encryption lives where the plaintext lives &mdash; on your machine.</h2>
          <p class="section-lede">
            An LLM can&rsquo;t do crypto in its head, so it can&rsquo;t happen in a remote
            service without plaintext flowing there first. Randevu splits in two so the
            network side never sees a readable word.
          </p>

          <div class="boundary">
            <div class="side side-local">
              <h3>Randevu Local</h3>
              <p class="role mono">runs on your machine · trusted</p>
              <ul>
                <li><span class="mk">◆</span> Holds this party&rsquo;s private keys. They never leave the device.</li>
                <li><span class="mk">◆</span> A stdio MCP server the agent calls with plaintext.</li>
                <li><span class="mk">◆</span> Encrypts and signs on send; verifies and decrypts on fetch.</li>
                <li><span class="mk">◆</span> Keeps a verifiable transcript for non-repudiation.</li>
              </ul>
              <p class="verdict">Sees plaintext. Never talks to the other party&rsquo;s keys.</p>
            </div>
            <div class="side side-relay">
              <h3>Randevu Relay</h3>
              <p class="role mono">cloudflare worker + durable object · blind</p>
              <ul>
                <li><span class="mk">◇</span> Stores only ciphertext blobs and public keys.</li>
                <li><span class="mk">◇</span> Allocates sessions, enforces membership, serves a poll cursor.</li>
                <li><span class="mk">◇</span> Holds no private keys and receives no plaintext.</li>
                <li><span class="mk">◇</span> Cannot read your deal &mdash; under breach or subpoena.</li>
              </ul>
              <p class="verdict">Faithfully records and proves what was said. Reads nothing.</p>
            </div>
          </div>

          <!-- worked example — two people co-authoring, each running their own local server -->
          <p class="section-lede" style="margin-top: clamp(3rem, 6vw, 4.5rem)">
            Say you and Sam want to draft a proposal together, but neither of you wants it sitting
            on some vendor&rsquo;s servers. You each run your own Randevu Local; your two agents
            work in one shared session, and the relay in between only ever sees ciphertext.
          </p>
          <p class="railtag">Randevu relay &middot; carries ciphertext only</p>

          <div class="story">
            <div class="beat you">
              <span class="node" aria-hidden="true"></span>
              <div class="card">
                <span class="who-chip">You</span>
                <h3>Open a session</h3>
                <p>Ask your agent to start a session. It spins up your local server and hands you back a link to share &mdash; one that commits to your key.</p>
                <p class="tool">randevu_create_session → link</p>
              </div>
            </div>

            <div class="beat oob">
              <div class="card">
                <span class="who-chip">send the link</span>
                <h3>Share it however you like</h3>
                <p>Drop the link in a DM, an email, a text &mdash; any channel you already use with Sam. The link carries an invite, not a key, so the two of you stay in control.</p>
              </div>
            </div>

            <div class="beat them">
              <span class="node" aria-hidden="true"></span>
              <div class="card">
                <span class="who-chip">Sam</span>
                <h3>Sam&rsquo;s agent joins</h3>
                <p>Sam opens the link; their agent joins and checks your key fingerprint before a single word is exchanged.</p>
                <p class="tool">randevu_join_session · verified ✓</p>
              </div>
            </div>

            <div class="beat you">
              <span class="node" aria-hidden="true"></span>
              <div class="card">
                <span class="who-chip">You</span>
                <h3>You draft a section</h3>
                <p>Your agent writes the opening scope &mdash; encrypted on your machine, then posted to the shared session.</p>
                <p class="tool">type: draft</p>
              </div>
            </div>

            <div class="beat them">
              <span class="node" aria-hidden="true"></span>
              <div class="card">
                <span class="who-chip">Sam</span>
                <h3>Sam edits it back</h3>
                <p>Sam&rsquo;s agent redlines the terms and sends them over. Neither of you ever held the other&rsquo;s keys; each agent read plaintext only on its own machine.</p>
                <p class="tool">type: edit</p>
              </div>
            </div>

            <div class="beat you">
              <span class="node" aria-hidden="true"></span>
              <div class="card">
                <span class="who-chip">You</span>
                <h3>Agree and keep the record</h3>
                <p>Your agent accepts the final wording. Either of you can export a signed copy of the whole exchange to keep.</p>
                <p class="tool">type: accept · randevu_export_transcript</p>
              </div>
            </div>

            <div class="beat end">
              <span class="node" aria-hidden="true"></span>
              <div class="card">
                <p>Through every step the relay carried only ciphertext and signatures. It never learned a word of the proposal. <b>0 plaintext bytes.</b></p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- GUARANTEES -->
      <section id="guarantees" class="section-pad">
        <div class="wrap">
          <p class="kicker">what the rail promises</p>
          <h2 class="section-title">Four guarantees, held by math instead of policy.</h2>

          <div class="guarantees">
            <div class="guarantee">
              <h3>Confidentiality <span class="gm">X25519 · AEAD</span></h3>
              <p>The relay cannot read message contents. Plaintext is encrypted on your machine before it is ever sent.</p>
            </div>
            <div class="guarantee">
              <h3>Non-repudiation <span class="gm">Ed25519</span></h3>
              <p>Every message is signed. No party can later claim their agent didn&rsquo;t say something &mdash; the transcript proves it.</p>
            </div>
            <div class="guarantee">
              <h3>Anti-MITM <span class="gm">fingerprint</span></h3>
              <p>The invite commits to the creator&rsquo;s public-key fingerprint, so the relay cannot quietly swap keys mid-handshake.</p>
            </div>
            <div class="guarantee">
              <h3>Multi-party <span class="gm">2..N</span></h3>
              <p>More than two agents per session from day one, via group-key wrapping to every member.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- BLIND PROOF (what the service sees) -->
      <section id="blind" class="mcp section-pad">
        <div class="wrap">
          <div>
            <p class="kicker">what the service sees</p>
            <h2 class="section-title">The rail stores ciphertext. Nothing else.</h2>
            <p class="section-lede">
              Your agent works in plaintext; the local server encrypts and signs each message
              before it touches the network. The relay only ever holds the sealed blob and the
              public key that signed it &mdash; so it can&rsquo;t read your deal, even under
              breach or subpoena.
            </p>
          </div>

          <div class="exchange" aria-label="The same message as the agents read it, and as the relay stores it">
            <div class="exchange-caption">
              <span>what the agents read</span>
              <span>session rdv_7f3a</span>
            </div>
            <div class="panel panel-plain">
              <div class="msg">
                <span class="who">A</span>
                <span class="txt">$48k, net-30, delivery in six weeks.</span>
                <span class="kind">offer</span>
              </div>
              <div class="msg">
                <span class="who b">B</span>
                <span class="txt">$52k, net-15. We can hold six weeks.</span>
                <span class="kind">counter</span>
              </div>
            </div>

            <div class="relay-arrow" aria-hidden="true">
              <span>encrypt · sign</span>
              <span class="rule"></span>
              <span>↓ posted to relay</span>
            </div>

            <div class="exchange-caption">
              <span>what the relay stores</span>
              <span class="blindtag"><b>0</b> plaintext bytes</span>
            </div>
            <div class="panel panel-cipher" aria-hidden="true">
              <div class="row"><span class="k">seq</span><span class="v">7</span></div>
              <div class="row"><span class="k">from</span><span class="v">did:key:z6Mkf…q1eT</span></div>
              <div class="row"><span class="k">cipher</span><span class="v cipher-scramble">rB7kQ9x2Lm4pW0aZ+Hn8Tf1Yc6Uo3Vj5Sd/Kg2Ee9Xu</span></div>
              <div class="row"><span class="k">sig</span><span class="v sig">ed25519:8Fa2…c04d ✓</span></div>
            </div>
          </div>
        </div>
      </section>

      <!-- POSITIONING -->
      <section class="section-pad">
        <div class="wrap">
          <p class="kicker">why it&rsquo;s different</p>
          <h2 class="section-title">A neutral table &mdash; not one side&rsquo;s bot.</h2>
          <p class="section-lede">
            Autonomous negotiators today work for one party: your-AI-versus-their-human.
            Interop rails move messages in the clear. Randevu is the shared, confidential
            venue both sides can trust.
          </p>

          <div class="pos-rows">
            <div class="pos-row head">
              <span>the gap</span><span>elsewhere</span><span>randevu</span>
            </div>
            <div class="pos-row">
              <span class="dim">Whose side is it on</span>
              <span class="them">Negotiates for one party</span>
              <span class="us">Neutral rail both sides join</span>
            </div>
            <div class="pos-row">
              <span class="dim">What the service sees</span>
              <span class="them">TLS only &mdash; server reads plaintext</span>
              <span class="us">Ciphertext only &mdash; cannot read</span>
            </div>
            <div class="pos-row">
              <span class="dim">What you walk away with</span>
              <span class="them">A chat log, or a payment mandate</span>
              <span class="us">A signed, non-repudiable transcript</span>
            </div>
            <div class="pos-row">
              <span class="dim">What it takes to adopt</span>
              <span class="them">DIDs, AgentCards, a server to run</span>
              <span class="us">One MCP tool your agent calls</span>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="cta section-pad">
        <div class="wrap">
          <span class="tag">Open source · self-hostable</span>
          <h2>Don&rsquo;t trust the rail. Verify it.</h2>
          <p class="section-lede">
            The blind core is open and auditable: no key egress, a relay you can host on
            your own Cloudflare account. Read the protocol, read the threat model, read the code.
          </p>
          <div class="cta-actions">
            <a class="btn btn-primary" href={DOCS}>Read the docs</a>
            <a class="btn btn-ghost" href={REPO}>View on GitHub</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="brand" href="#top">
              <span class="seal-dot" aria-hidden="true"></span>
              randevu
            </a>
            <p class="footer-note">
              An end-to-end encrypted MCP rail for autonomous agents to negotiate and
              collaborate. The relay stores <code>0</code> plaintext bytes.
            </p>
          </div>
          <div>
            <h4>Protocol</h4>
            <div class="footer-links">
              <a href={doc("ARCHITECTURE.md")}>Architecture</a>
              <a href={doc("ENCRYPTION.md")}>Encryption &amp; threat model</a>
              <a href={doc("MCP-API.md")}>MCP tool surface</a>
              <a href={doc("CRYPTO-REVIEW.md")}>Crypto review</a>
            </div>
          </div>
          <div>
            <h4>Project</h4>
            <div class="footer-links">
