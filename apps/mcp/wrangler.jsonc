{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Randevu remote MCP server (Cloudflare Worker + Durable Objects).
  // Two agents connect to /mcp and meet in a shared Room. Plaintext (test tier).
  "name": "randevu-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "mcp.randevu.run", "custom_domain": true }],
  // Public base URL (invite links) + email from-address. Invitations send via Resend
  // when the RESEND_API_KEY secret is set (`wrangler secret put RESEND_API_KEY`).
  "vars": {
    "PUBLIC_URL": "https://mcp.randevu.run",
    "FROM_EMAIL": "invites@send.randevu.run"
  },
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "RANDEVU_MCP", "class_name": "RandevuMcp" },
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RandevuMcp", "Room"] }
  ]
}
